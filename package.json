{
    "name": "recipe-archive-app",
    "version": "0.0.8",
    "scripts": {
        "ng": "ng",
        "start": "ng serve -c development",
        "prebuild": "standard-version",
        "build": "ng build -c production --base-href https://johngtka.github.io/RecipeArchiveApp/browser",
        "postbuild": "git push --follow-tags && npx angular-cli-ghpages --dir=dist/recipe-archive-app/browser",
        "watch": "ng build --watch --configuration production",
        "format": "prettier --write ./**/*.{ts,json,html,css}",
        "test": "ng test",
        "prepare": "husky install",
        "update": "npm update",
        "frameupdate": "ng update"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^20.3.18",
        "@angular/cdk": "^19.2.19",
        "@angular/common": "^20.3.18",
        "@angular/compiler": "^20.3.18",
        "@angular/core": "^20.3.18",
        "@angular/forms": "^20.3.18",
        "@angular/material": "^19.2.19",
        "@angular/platform-browser": "^20.3.18",
        "@angular/platform-browser-dynamic": "^20.3.18",
        "@angular/router": "^20.3.18",
        "@ngx-translate/core": "^15.0.0",
        "@ngx-translate/http-loader": "^8.0.0",
        "http-client": "^4.3.1",
        "prettier": "^3.8.1",
        "rxjs": "~7.8.0",
        "standard-version": "^9.5.0",
        "tslib": "^2.3.0",
        "zone.js": "~0.15.1"
    },
    "devDependencies": {
        "@angular/build": "^20.3.22",
        "@angular/cli": "^20.3.22",
        "@angular/compiler-cli": "^20.3.18",
        "@types/jasmine": "~5.1.0",
        "husky": "^9.1.7",
        "jasmine-core": "~5.2.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "typescript": "~5.9.3"
    }
}
